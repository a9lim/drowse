+            "The loaded model library does not expose the Drowse J-lens probability function",
+          );
+        }
+        Object.assign(next, {
+          jLensTokenIds: i32(
+            [DROWSE_STRUCTURED_MAX_PROBES],
+            program.jLensTokenIds!,
