+    ),
+  ).toBe(true);
+  expect(planDrowseSaeChunks(4, 3, limits)).toEqual([
+    {
+      featureOffset: 0,
+      featureCount: 3,
+      paddedFeatureCount: 8,
+      encoderByteLength: 128,
+    },
+  ]);
+  expect(() =>
+    planDrowseSaeChunks(4, 8, {
+      maxBufferSize: 127,
+      maxStorageBufferBindingSize: 127,
+    }),
