+                output[layer_id, probe] = current[probe]
+
+    return op.tensor_ir_inplace_op(
+        _store,
+        "drowse_store_structured_measurements",
+        args=[measurement, values],
+        inplace_indices=[1],
+        out=Tensor.placeholder(values.shape, "float32"),
+    )
