{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["svelte"],
    "baseUrl": ".",
    "paths": {
      "@runtime-jlens-missing": ["src/drawers/token/JLensMissingState.svelte"],
      "@runtime-jlens-source": ["src/panels/JLensSourceSection.svelte"],
      "@runtime-local-drawer": ["src/drawers/LocalRuntimeDrawer.svelte"],
      "@runtime-sae-source": ["src/panels/SaeSourceSection.svelte"],
      "@runtime-session-drawer": ["src/drawers/SessionAdminDrawer.svelte"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
