{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drowse-contact",
  "account_id": "18903e07043611bf77d67976b4bbc530",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "drowse.ai/api/contact*", "zone_name": "drowse.ai" }],
  "send_metrics": false,
  "vars": { "CONTACT_ENABLED": "false" },
  "send_email": [{
    "name": "EMAIL",
    "destination_address": "contact@drowse.ai",
    "allowed_sender_addresses": ["feedback@drowse.ai"]
  }],
  "durable_objects": { "bindings": [{ "name": "SUBMISSIONS", "class_name": "ContactSubmission" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactSubmission"] }],
  "ratelimits": [
    { "name": "ATTEMPTS", "namespace_id": "24001", "simple": { "limit": 5, "period": 60 } },
    { "name": "VOLUME", "namespace_id": "24002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
