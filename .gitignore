*.py[cod]
*.egg-info/
*.egg
uv.lock
dist/
build/
*.whl

# Web UI build artifact ships in the wheel — committed despite the
# generic dist/ rule above.  Refresh via `cd webui && npm run build`.
!drowse/web/dist/
!drowse/web/dist/**

# Node modules from the webui/ Svelte source.
webui/node_modules/
webui/dist/

# Virtual environments
.venv/
venv/
env/

# pytest / ruff
.pytest_cache/
.ruff_cache/
.coverage

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/
.remember/
.superpowers/
docs/superpowers/

# Scratch / throwaway dev artifacts (eyeball-once output, stress scripts)
/scratch_*/
**/scratch_*.py
scripts/out/

# Local research experiments (scripts + results live outside version control)
scripts/experiments/

