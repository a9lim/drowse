# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
uv.lock
dist/
build/
*.whl

# Web UI build artifact ships in the wheel — committed despite the
# generic dist/ rule above.  Refresh via `cd webui && npm run build`.
!drowse/web/dist/
!drowse/web/dist/**

# Node modules from the webui/ Svelte source.
webui/node_modules/
webui/dist/
webui/dist-hosted/
.playwright-mcp/

# Browser-runtime compiler scratch directories are local feasibility outputs.
browser-runtime/.v3-compile.*/
browser-runtime/.local-build/
browser-runtime/vendor/*.tgz
!browser-runtime/vendor/drowse-web-llm-0.2.84-drowse.32.tgz
!browser-runtime/vendor/drowse-web-llm-0.2.84-drowse.34.tgz

# Virtual environments
.venv/
venv/
env/

# pytest / ruff
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/
.remember/
.superpowers/
docs/superpowers/

# Scratch / throwaway dev artifacts (eyeball-once output, stress scripts)
/scratch_*/
**/scratch_*.py
scripts/out/

# Local research experiments (scripts + results live outside version control)
scripts/experiments/
